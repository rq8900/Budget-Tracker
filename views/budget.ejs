<!DOCTYPE html>
<html>
<head>
    <title>Set Budget</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
    <a href="/" class="navbar-brand">Budget App</a>
</nav>

<div class="container mt-5">

    <div class="card p-4 mx-auto" style="max-width:500px;">
        <h3 class="mb-3">Set Monthly Budget</h3>

        <form method="POST" action="/budget">
            <input type="number" name="budget" class="form-control mb-3" placeholder="Enter budget" required>

            <button class="btn btn-primary w-100">Set Budget</button>
        </form>

        <a href="/" class="btn btn-link mt-3">Back</a>
    </div>

</div>

</body>
</html>