<!DOCTYPE html>
<html>
<head>
    <title>Budget App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
    <span class="navbar-brand">Budget App</span>
</nav>

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1>Personal Budget Tracker</h1>
        <p class="text-muted">Track income, expenses and budget easily</p>
    </div>

    <div class="row g-3">

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <a href="/income" class="btn btn-success">Add Income</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <a href="/expense" class="btn btn-danger">Add Expense</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <a href="/budget" class="btn btn-primary">Set Budget</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <a href="/balance" class="btn btn-dark">View Balance</a>
            </div>
        </div>

    </div>
</div>

</body>
</html>