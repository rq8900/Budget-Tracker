<!DOCTYPE html>
<html>
<head>
    <title>Balance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
    <a href="/" class="navbar-brand">Budget App</a>
</nav>

<div class="container mt-5">

    <h2 class="mb-4">Balance Overview</h2>

    <div class="row g-3">

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <h5>Total Income</h5>
                <h3 class="text-success"><%= totalIncome %></h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <h5>Total Expense</h5>
                <h3 class="text-danger"><%= totalExpense %></h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <h5>Budget</h5>
                <h3 class="text-primary"><%= budget %></h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <h5>Remaining</h5>
                <h3 class="<%= remaining >= 0 ? 'text-success' : 'text-danger' %>">
                    <%= remaining %>
                </h3>
            </div>
        </div>

    </div>

    <a href="/" class="btn btn-link mt-4">Back Home</a>

</div>

</body>
</html>